{
  "id": "1",
  "name": "Local Open Source AI Pipeline",
  "nodes": [
    {
      "parameters": {
        "path": "ai-pipeline",
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 200]
    },
    {
      "parameters": {
        "model": "llama3:latest",
        "prompt": "Analyze this text and extract key action items: {{ $json.body.text }}"
      },
      "id": "b2c3d4e5-f67a-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "Local OpenSource LLM",
      "type": "n8n-nodes-base.ollama",
      "typeVersion": 1,
      "position": [300, 200]
    },
    {
      "parameters": {
        "fileToWrite": "/data/output/ai_output.txt",
        "fileContent": "=== NEW LOCAL PIPELINE RUN ===\nTimestamp: {{ new Date().toISOString() }}\n\n{{ $json.alternativeText || $json.text }}\n\n========================\n",
        "appendToFile": true
      },
      "id": "d4e5f67a-8b9c-0d1e-2f3a-4b5c6d7e8f9a",
      "name": "Write Binary File",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [500, 200]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{"node": "Local OpenSource LLM", "type": "main", "index": 0}]]
    },
    "Local OpenSource LLM": {
      "main": [[{"node": "Write Binary File", "type": "main", "index": 0}]]
    }
  }
}
